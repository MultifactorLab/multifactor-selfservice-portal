@model int

<div class="pwd-toast" id="pwd-expiration-toast" role="alert">
    <div class="pwd-toast-inner">
        <span class="pwd-toast-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <circle cx="9" cy="9" r="8.25" stroke="currentColor" stroke-width="1.5"/>
                <path d="M9 5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="9" cy="12.75" r="0.9" fill="currentColor"/>
            </svg>
        </span>
        <div class="pwd-toast-content">
            <div class="pwd-toast-text">
                <p class="pwd-toast-title">@Localizer["ShouldChangePassword"]</p>
                <p class="pwd-toast-subtitle">@Localizer["PasswordExpirationDaysLeft"]: @Model</p>
            </div>
            <a href="~/password/change" class="pwd-toast-link">@Localizer["ChangePassword"]</a>
        </div>
        <button type="button" class="pwd-toast-close" aria-label="@Localizer["Close"]" data-pwd-toast-close>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4L12 12M12 4L4 12" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
</div>

<script>
    (function () {
        var toast = document.getElementById('pwd-expiration-toast');
        if (!toast) return;
        var closeBtn = toast.querySelector('[data-pwd-toast-close]');
        if (!closeBtn) return;
        closeBtn.addEventListener('click', function () {
            toast.classList.add('is-hiding');
            toast.addEventListener('animationend', function () {
                toast.remove();
            }, { once: true });
        });
    })();
</script>
